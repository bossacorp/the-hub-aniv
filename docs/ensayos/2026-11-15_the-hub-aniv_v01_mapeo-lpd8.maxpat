                    "presentation": 1,
                    "presentation_rect": [ 32.0, 560.0, 554.0, 18.0 ],
                    "text": "Monitor MIDI: mueve un control del LPD8 y mira qué número llega. Si no llega nada, revisa Bluetooth en Audio MIDI Setup.",
                    "textcolor": [ 0.72, 0.72, 0.74, 1.0 ]
                }
